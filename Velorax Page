<style>
/* =========================================================
   VELORAX — LUXURY TECH STORE
   ========================================================= */

:root {
    --black: #080808;
    --dark: #111111;
    --white: #ffffff;
    --cream: #f5f5f1;
    --gray: #777;
    --light-gray: #e5e5df;
    --border: #d8d8d2;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--cream);
    color: var(--black);
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font-family: inherit;
}

/* =========================================================
   ANNOUNCEMENT
   ========================================================= */

.announcement {
    height: 38px;
    background: var(--black);
    color: white;

    display: flex;
    justify-content: center;
    align-items: center;

    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

/* =========================================================
   NAVIGATION
   ========================================================= */

.navbar {
    height: 80px;

    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(245,245,241,0.94);
    backdrop-filter: blur(15px);

    border-bottom: 1px solid rgba(0,0,0,0.08);
}

.nav-container {
    max-width: 1400px;
    height: 100%;

    margin: auto;
    padding: 0 35px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: 7px;
}

.nav-links {
    display: flex;
    gap: 35px;

    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.nav-links a {
    transition: opacity .2s;
}

.nav-links a:hover {
    opacity: .5;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
}

.nav-button {
    border: none;
    background: none;
    cursor: pointer;

    font-size: 12px;
}

.cart-button {
    position: relative;
}

.cart-count {
    position: absolute;

    top: -10px;
    right: -12px;

    width: 19px;
    height: 19px;

    border-radius: 50%;

    background: black;
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 9px;
}

.mobile-menu-button {
    display: none;
}

/* =========================================================
   HERO
   ========================================================= */

.hero {
    min-height: 760px;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.88),
            rgba(0,0,0,.48),
            rgba(0,0,0,.1)
        ),
        radial-gradient(
            circle at 80% 50%,
            #4b4b4b,
            #151515 45%,
            #050505 75%
        );

    color: white;

    display: flex;
    align-items: center;
}

.hero-container {
    max-width: 1400px;
    width: 100%;

    margin: auto;
    padding: 80px 35px;
}

.eyebrow {
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    font-weight: bold;

    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(60px, 9vw, 130px);

    line-height: .88;

    letter-spacing: -7px;

    max-width: 900px;
}

.hero-text {
    max-width: 500px;

    color: #d5d5d5;

    font-size: 17px;

    line-height: 1.7;

    margin: 30px 0;
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 25px;
}

.button {
    padding: 16px 28px;

    border: 1px solid black;

    text-transform: uppercase;

    font-size: 10px;

    letter-spacing: 2px;

    cursor: pointer;

    transition: .25s;
}

.button-white {
    background: white;
    color: black;
    border-color: white;
}

.button-white:hover {
    background: transparent;
    color: white;
}

.text-link {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;

    border-bottom: 1px solid white;

    padding-bottom: 4px;
}

/* =========================================================
   SECTION
   ========================================================= */

.section {
    padding: 110px 35px;
}

.container {
    max-width: 1400px;
    margin: auto;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: end;

    margin-bottom: 45px;
}

.section-title {
    font-size: clamp(42px, 6vw, 75px);

    letter-spacing: -5px;

    line-height: .95;
}

.view-all {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;

    border-bottom: 1px solid black;
    padding-bottom: 5px;
}

/* =========================================================
   PRODUCTS
   ========================================================= */

.products {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}

.product {
    cursor: pointer;
}

.product-image {
    height: 390px;

    background: #e5e5df;

    position: relative;

    overflow: hidden;
}

.product-image::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
        radial-gradient(
            circle at 50% 45%,
            #555,
            transparent 30%
        );

    opacity: .8;

    transition: transform .7s;
}

.product:hover .product-image::after {
    transform: scale(1.15);
}

.product-badge {
    position: absolute;

    top: 15px;
    left: 15px;

    z-index: 2;

    background: black;
    color: white;

    padding: 7px 10px;

    font-size: 9px;

    letter-spacing: 1px;

    text-transform: uppercase;
}

.product-info {
    padding: 16px 3px;
}

.product-info-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.product-name {
    font-size: 14px;
    font-weight: 600;
}

.product-price {
    font-size: 13px;
}

.product-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-top: 13px;
}

.stars {
    font-size: 10px;
    letter-spacing: 2px;
}

.add-button {
    border: none;
    border-bottom: 1px solid black;

    background: none;

    font-size: 9px;

    text-transform: uppercase;

    letter-spacing: 2px;

    cursor: pointer;
}

/* =========================================================
   BENEFITS
   ========================================================= */

.benefits {
    background: black;
    color: white;

    padding: 70px 35px;
}

.benefit-grid {
    max-width: 1400px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(4,1fr);

    gap: 40px;
}

.benefit-icon {
    font-size: 25px;

    margin-bottom: 18px;
}

.benefit h3 {
    font-size: 12px;

    letter-spacing: 2px;

    text-transform: uppercase;

    margin-bottom: 10px;
}

.benefit p {
    color: #999;

    font-size: 13px;

    line-height: 1.6;
}

/* =========================================================
   EDITORIAL
   ========================================================= */

.editorial {
    display: grid;

    grid-template-columns: 1.15fr .85fr;

    min-height: 650px;
}

.editorial-image {
    background:
        radial-gradient(
            circle at 50% 40%,
            #777,
            #222 40%,
            #090909
        );
}

.editorial-content {
    background: #e7e7e2;

    padding: 100px;

    display: flex;

    flex-direction: column;

    justify-content: center;
}

.editorial-content h2 {
    font-size: clamp(45px, 6vw, 80px);

    line-height: .95;

    letter-spacing: -5px;
}

.editorial-content p {
    max-width: 470px;

    color: #555;

    line-height: 1.8;

    margin: 30px 0;
}

/* =========================================================
   REVIEWS
   ========================================================= */

.reviews {
    background: #e7e7e2;

    padding: 110px 35px;
}

.review-grid {
    max-width: 1400px;

    margin: 45px auto 0;

    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 20px;
}

.review {
    background: #f5f5f1;

    padding: 40px;

    min-height: 270px;

    display: flex;

    flex-direction: column;
}

.review-text {
    font-size: 21px;

    line-height: 1.3;

    margin: 25px 0;
}

.review-name {
    margin-top: auto;

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 2px;
}

/* =========================================================
   NEWSLETTER
   ========================================================= */

.newsletter {
    text-align: center;

    padding: 130px 35px;
}

.newsletter h2 {
    font-size: clamp(45px,6vw,80px);

    letter-spacing: -5px;
}

.newsletter p {
    max-width: 500px;

    margin: 25px auto 35px;

    color: #666;
}

.newsletter-form {
    max-width: 500px;

    margin: auto;

    display: flex;
}

.newsletter-form input {
    flex: 1;

    border: 1px solid #bbb;

    background: white;

    padding: 16px;
}

.newsletter-form button {
    border: none;

    background: black;

    color: white;

    padding: 0 25px;

    text-transform: uppercase;

    letter-spacing: 2px;

    font-size: 10px;

    cursor: pointer;
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
    background: black;

    color: white;

    padding: 80px 35px 25px;
}

.footer-grid {
    max-width: 1400px;

    margin: auto;

    display: grid;

    grid-template-columns: 1.5fr 1fr 1.5fr;

    gap: 70px;
}

.footer-logo {
    font-size: 22px;

    font-weight: 900;

    letter-spacing: 7px;
}

.footer p {
    color: #888;

    line-height: 1.7;

    max-width: 350px;
}

.footer h3 {
    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 2px;

    margin-bottom: 20px;
}

.footer-links a {
    display: block;

    color: #aaa;

    font-size: 13px;

    margin: 10px 0;
}

.footer-bottom {
    max-width: 1400px;

    margin: 70px auto 0;

    padding-top: 20px;

    border-top: 1px solid #333;

    color: #666;

    font-size: 10px;

    display: flex;

    justify-content: space-between;
}

/* =========================================================
   CART
   ========================================================= */

.cart-overlay {
    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.5);

    opacity: 0;

    visibility: hidden;

    transition: .3s;

    z-index: 2000;
}

.cart-overlay.active {
    opacity: 1;

    visibility: visible;
}

.cart {
    position: absolute;

    right: 0;

    top: 0;

    height: 100%;

    width: min(450px,90%);

    background: #f5f5f1;

    padding: 35px;

    transform: translateX(100%);

    transition: .35s;

    display: flex;

    flex-direction: column;
}

.cart-overlay.active .cart {
    transform: translateX(0);
}

.cart-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding-bottom: 25px;

    border-bottom: 1px solid #ccc;
}

.close {
    border: none;

    background: none;

    font-size: 28px;

    cursor: pointer;
}

.cart-items {
    flex: 1;

    overflow-y: auto;

    padding: 20px 0;
}

.cart-item {
    display: flex;

    justify-content: space-between;

    gap: 15px;

    padding: 15px 0;

    border-bottom: 1px solid #ddd;
}

.cart-item button {
    border: none;

    background: none;

    text-decoration: underline;

    cursor: pointer;

    font-size: 10px;
}

.cart-footer {
    border-top: 1px solid #ccc;

    padding-top: 20px;
}

.cart-total {
    display: flex;

    justify-content: space-between;

    font-size: 18px;

    margin-bottom: 20px;
}

.checkout {
    width: 100%;

    border: none;

    background: black;

    color: white;

    padding: 18px;

    text-transform: uppercase;

    letter-spacing: 2px;

    cursor: pointer;
}

/* =========================================================
   SEARCH
   ========================================================= */

.search-overlay {
    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.6);

    z-index: 3000;

    opacity: 0;

    visibility: hidden;

    transition: .3s;
}

.search-overlay.active {
    opacity: 1;

    visibility: visible;
}

.search-box {
    background: #f5f5f1;

    padding: 80px 35px;
}

.search-inner {
    max-width: 900px;

    margin: auto;

    display: flex;
}

.search-inner input {
    flex: 1;

    border: none;

    border-bottom: 1px solid black;

    background: transparent;

    font-size: 35px;

    padding: 15px;
}

.search-inner button {
    border: none;

    background: black;

    color: white;

    padding: 0 30px;

    cursor: pointer;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width: 1000px) {

    .nav-links {
        display: none;
    }

    .mobile-menu-button {
        display: block;
    }

    .products {
        grid-template-columns: repeat(2,1fr);
    }

    .benefit-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .editorial {
        grid-template-columns: 1fr;
    }

    .editorial-image {
        min-height: 500px;
    }

    .review-grid {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media(max-width: 600px) {

    .nav-container {
        padding: 0 18px;
    }

    .logo {
        font-size: 18px;
        letter-spacing: 5px;
    }

    .hero {
        min-height: 650px;
    }

    .hero-container {
        padding: 60px 20px;
    }

    .hero h1 {
        font-size: 60px;
        letter-spacing: -4px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

    .section {
        padding: 75px 18px;
    }

    .section-title {
        font-size: 45px;
    }

    .products {
        grid-template-columns: 1fr 1fr;

        gap: 20px 10px;
    }

    .product-image {
        height: 230px;
    }

    .benefits {
        padding: 60px 18px;
    }

    .benefit-grid {
        grid-template-columns: 1fr 1fr;
    }

    .editorial-content {
        padding: 65px 25px;
    }

    .editorial-content h2 {
        font-size: 50px;
    }

    .reviews {
        padding: 75px 18px;
    }

    .newsletter {
        padding: 80px 18px;
    }

    .newsletter h2 {
        font-size: 50px;
    }

    .newsletter-form {
        flex-direction: column;
        gap: 10px;
    }

    .newsletter-form button {
        padding: 16px;
    }

    footer {
        padding: 65px 18px 20px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 10px;
    }
}
</style>
</head>

